# Friendly URLs — serve index.html by default
DirectoryIndex index.html

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Force HTTPS in production
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} =on
    RewriteRule ^ - [END]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# ============================================================
# SPEED FIXES
# ============================================================

# Enable gzip / deflate for text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/x-javascript application/x-httpd-php
</IfModule>

# Aggressive caching for static assets — tells Cloudflare CDN to cache too
<IfModule mod_headers.c>
    # Hashed/long-lived assets — 1 year, immutable
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.html — short cache so updates roll out fast
    <FilesMatch "index\.html$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # /api/* — never cache (dynamic)
    <LocationMatch "^/api/">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </LocationMatch>
</IfModule>

# Enable keep-alive + send ETags for conditional GETs
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript       "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType text/html             "access plus 5 minutes"
</IfModule>
